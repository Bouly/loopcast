<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Tunnel iOS 17+ (captures, mode développeur). Root requis : va dans /Library/LaunchDaemons. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.loopcast.tunneld</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYMOBILEDEVICE3__</string>
    <string>remote</string>
    <string>tunneld</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/var/log/loopcast-tunneld.log</string>
  <key>StandardErrorPath</key><string>/var/log/loopcast-tunneld.log</string>
</dict>
</plist>
